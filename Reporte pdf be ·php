<?php
session_start();
require '../vendor/autoload.php';

include 'conexion_be.php';

// ?tipo=libros | usuarios | ventas
$tipo = isset($_GET['tipo']) ? $_GET['tipo'] : 'libros';

$mpdf = new \Mpdf\Mpdf(['format' => 'A4', 'margin_top' => 20, 'margin_bottom' => 15]);

$fechaReporte = date('d/m/Y H:i');

$html = '
<style>
    body { font-family: sans-serif; }
    h1 { color: #b45309; font-size: 20px; margin-bottom: 0; }
    .subtitulo { color: #777; font-size: 11px; margin-top: 2px; margin-bottom: 20px; }
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th { background-color: #b45309; color: #fff; padding: 6px; text-align: left; }
    td { padding: 6px; border-bottom: 1px solid #eee; }
    tr:nth-child(even) { background-color: #fdf6ec; }
    .total-row td { font-weight: bold; border-top: 2px solid #b45309; }
</style>
<h1>AURORA.LIBROS</h1>
<p class="subtitulo">Reporte generado el ' . $fechaReporte . '</p>
';

switch ($tipo) {

    case 'usuarios':
        $html .= '<h2>Usuarios Registrados</h2>';
        $html .= '<table><thead><tr><th>ID</th><th>Nombre Completo</th><th>Email</th><th>Usuario</th></tr></thead><tbody>';
        $query = "SELECT id, nombre_completo, email, usuario FROM usuarios ORDER BY id";
        $result = mysqli_query($conexion, $query);
        $total = 0;
        while ($row = mysqli_fetch_assoc($result)) {
            $html .= "<tr>
                <td>{$row['id']}</td>
                <td>" . htmlspecialchars($row['nombre_completo']) . "</td>
                <td>" . htmlspecialchars($row['email']) . "</td>
                <td>" . htmlspecialchars($row['usuario']) . "</td>
            </tr>";
            $total++;
        }
        $html .= '</tbody></table>';
        $html .= "<p style='margin-top:15px;'><strong>Total de usuarios: $total</strong></p>";
        $filename = 'reporte_usuarios_' . date('Y-m-d') . '.pdf';
        break;

    case 'ventas':
        $html .= '<h2>Historial de Ventas</h2>';
        $html .= '<table><thead><tr><th>ID Pedido</th><th>Fecha</th><th>Cliente</th><th>Total</th></tr></thead><tbody>';
        $query = "SELECT p.id, p.fecha, u.nombre_completo, p.total 
                  FROM pedidos p 
                  JOIN usuarios u ON p.usuario_id = u.id 
                  ORDER BY p.fecha DESC";
        $result = mysqli_query($conexion, $query);
        $totalGeneral = 0;
        while ($row = mysqli_fetch_assoc($result)) {
            $html .= "<tr>
                <td>#{$row['id']}</td>
                <td>" . date('d/m/Y H:i', strtotime($row['fecha'])) . "</td>
                <td>" . htmlspecialchars($row['nombre_completo']) . "</td>
                <td>$" . number_format($row['total'], 2) . "</td>
            </tr>";
            $totalGeneral += $row['total'];
        }
        $html .= "<tr class='total-row'><td colspan='3' style='text-align:right;'>TOTAL GENERAL:</td><td>$" . number_format($totalGeneral, 2) . "</td></tr>";
        $html .= '</tbody></table>';
        $filename = 'reporte_ventas_' . date('Y-m-d') . '.pdf';
        break;

    case 'libros':
    default:
        $html .= '<h2>Inventario de Libros</h2>';
        $html .= '<table><thead><tr><th>ID</th><th>Título</th><th>Autor</th><th>Categoría</th><th>Precio</th><th>Stock</th></tr></thead><tbody>';
        $query = "SELECT id, titulo, author, category, price, stock FROM libros ORDER BY id";
        $result = mysqli_query($conexion, $query);
        $valorTotalInventario = 0;
        while ($row = mysqli_fetch_assoc($result)) {
            $html .= "<tr>
                <td>{$row['id']}</td>
                <td>" . htmlspecialchars($row['titulo']) . "</td>
                <td>" . htmlspecialchars($row['author']) . "</td>
                <td>" . htmlspecialchars($row['category']) . "</td>
                <td>$" . number_format($row['price'], 2) . "</td>
                <td>{$row['stock']}</td>
            </tr>";
            $valorTotalInventario += $row['price'] * $row['stock'];
        }
        $html .= "<tr class='total-row'><td colspan='4' style='text-align:right;'>VALOR TOTAL DEL INVENTARIO:</td><td colspan='2'>$" . number_format($valorTotalInventario, 2) . "</td></tr>";
        $html .= '</tbody></table>';
        $filename = 'reporte_libros_' . date('Y-m-d') . '.pdf';
        break;
}

$mpdf->WriteHTML($html);
$mpdf->Output($filename, 'D'); // D = fuerza la descarga
exit;
